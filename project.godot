; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hollowdeck"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

RunManager="*res://scripts/run/RunManager.cs"
AudioManager="*res://scripts/run/AudioManager.cs"
MetaProgressionManager="*res://scripts/run/MetaProgressionManager.cs"
SettingsManager="*res://scripts/run/SettingsManager.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Hollowdeck"

[gui]

theme/custom="res://assets/theme/hollowdeck_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
; Warm near-black (PixelSpec.Ramp.N0). Was a cool slate 0.07,0.075,0.095 -
; the last survivor of the deleted generic blue theme, visible as a cold edge
; wherever a screen didn't fill the window.
environment/defaults/default_clear_color=Color(0.027451, 0.023529, 0.039216, 1)
; Nearest project-wide (docs/ART_SPEC.md section 3). The .tscn sprites set
; texture_filter=1 individually, but every icon built in code - card art,
; relics, potions, statuses, intents, map nodes - inherited the Linear default
; and was being bilinearly blurred. Setting the default is what actually
; covers them; the two smooth procedural gradients in ScreenBackground opt
; back to Linear explicitly.
textures/canvas_textures/default_texture_filter=0
