; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hollowdeck"
; The only source Godot has for the Windows .exe's file/product version and the
; macOS Info.plist's CFBundleShortVersionString, since export_presets.cfg leaves
; both of those blank - so this is the one number to bump. Numeric-and-dots
; only: a "0.1.0-dev" here makes Godot warn and silently substitute 1.0.0.
; MainMenu reads it back out of ProjectSettings so it can reach a bug report.
config/version="0.1.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

RunManager="*res://scripts/run/RunManager.cs"
AudioManager="*res://scripts/run/AudioManager.cs"
MetaProgressionManager="*res://scripts/run/MetaProgressionManager.cs"
SettingsManager="*res://scripts/run/SettingsManager.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="Hollowdeck"

[gui]

theme/custom="res://assets/theme/hollowdeck_theme.tres"

[input]

; Named actions rather than raw `Key.X` switches, so every binding lives in one
; place and a future rebinding UI has a layer to rebind (ROADMAP "Input
; actions"). Godot's own ui_accept/ui_cancel are left alone and still drive
; focused-button presses on the non-combat screens; these hd_* actions are for
; the surfaces that do their own input handling, chiefly CombatScreen.
;
; Card slots carry both the top-row digit and the matching numpad key. Potions
; are Z/X/C rather than Shift+1..3 because InputEvent.IsActionPressed defaults
; to exact_match:false, which would make Shift+1 also fire hd_card_1.
; Q/W/E/D (piles) are why nothing here binds WASD for navigation.
;
; hd_inspect is Up rather than a letter: it is *held* rather than pressed, it
; sits beside the left/right the hand already cycles with, and "up" is what the
; card does - it is the same lift the hover affordance carries, taken further.

hd_confirm={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
