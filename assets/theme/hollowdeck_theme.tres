; The one project-wide theme, set as gui/theme/custom in project.godot.
;
; Merged from the two themes that used to fight: this file's own slate-blue
; generic dark-UI styleboxes (bg 0.165,0.184,0.243, no font at all) and
; combat_theme.tres's typography, which was attached to only 3 of 13 scenes.
; That split is why Shop/Rest/Event/Treasure/RunEnd/Settings/Unlocks/Map
; rendered in stock Godot sans-serif with grey-blue buttons while combat sat
; in bronze bezels. There are no per-scene theme overrides any more.
;
; Every colour below is a PixelSpec.Ramp entry (docs/ART_SPEC.md section 5).
; Per section 6 there are no corner radii and no shadow blurs anywhere -
; both are anti-aliased effects that cannot exist in pixels.
;
; The buttons and the panel are StyleBoxTexture 9-slices over generated pixel
; border art (assets/theme/*.png, from tools/artgen's `chrome` category). Every
; colour in them is decided there rather than here, which is why those blocks
; carry no bg_color/border_color.
;
; Two properties on each are correctness rather than taste, and both are
; asserted by PixelSpecSmokeTest because both are wrong-by-default:
;
;   axis_stretch_horizontal/vertical = 1 (Tile). The default is 0 (Stretch),
;   which resamples the edge strip to whatever fractional width the box happens
;   to be - a non-integer scale, which section 2 calls a bug rather than a
;   judgement call. 2 (TileFit) rescales tiles to fit a whole number of them,
;   which is the same violation from the other side.
;
;   texture_margin_* is the corner budget from section 1: at most a third of
;   the slice, so 8 of 24 for the buttons and 5 of 16 for the panel.
;
; What is still StyleBoxFlat below - the progress bars, the slider, the
; scrollbars - is flat because ChromeStyles mirrors it in code and the comments
; on both sides say the pair must not drift. They move together or not at all.

[gd_resource type="Theme" load_steps=22 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Silkscreen-Bold.ttf" id="1"]
[ext_resource type="FontFile" path="res://assets/fonts/Tiny5-Regular.ttf" id="2"]
[ext_resource type="Texture2D" uid="uid://cfh5f588nsxag" path="res://assets/theme/button_normal.png" id="3"]
[ext_resource type="Texture2D" uid="uid://dgaobs07phmbj" path="res://assets/theme/button_hover.png" id="4"]
[ext_resource type="Texture2D" uid="uid://88ccupyyinap" path="res://assets/theme/button_pressed.png" id="5"]
[ext_resource type="Texture2D" uid="uid://cf6b781dfrrf2" path="res://assets/theme/button_disabled.png" id="6"]
[ext_resource type="Texture2D" uid="uid://beuff2a114bbi" path="res://assets/theme/button_focus.png" id="7"]
[ext_resource type="Texture2D" uid="uid://bnvj4lhahgb3o" path="res://assets/theme/panel.png" id="8"]

; --- Buttons: N2 face, G1 bezel; hover brightens the bezel to G4 rather than
; swapping hue, the same "hover is a pure brightness signal" rule CardView's
; frame styling already follows. Those colours now live in
; tools/artgen/src/icons/chrome.rs, one `fn` per state.

[sub_resource type="StyleBoxTexture" id="sb_btn_normal"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
texture = ExtResource("3")
texture_margin_left = 8.0
texture_margin_top = 8.0
texture_margin_right = 8.0
texture_margin_bottom = 8.0
axis_stretch_horizontal = 1
axis_stretch_vertical = 1

[sub_resource type="StyleBoxTexture" id="sb_btn_hover"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
texture = ExtResource("4")
texture_margin_left = 8.0
texture_margin_top = 8.0
texture_margin_right = 8.0
texture_margin_bottom = 8.0
axis_stretch_horizontal = 1
axis_stretch_vertical = 1

[sub_resource type="StyleBoxTexture" id="sb_btn_pressed"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
texture = ExtResource("5")
texture_margin_left = 8.0
texture_margin_top = 8.0
texture_margin_right = 8.0
texture_margin_bottom = 8.0
axis_stretch_horizontal = 1
axis_stretch_vertical = 1

[sub_resource type="StyleBoxTexture" id="sb_btn_disabled"]
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0
texture = ExtResource("6")
texture_margin_left = 8.0
texture_margin_top = 8.0
texture_margin_right = 8.0
texture_margin_bottom = 8.0
axis_stretch_horizontal = 1
axis_stretch_vertical = 1

; Keyboard focus. G5, the top of the gold ramp (UiTheme.Palette.FocusRing) -
; NOT G4, which is what this was and is also exactly the border
; ChromeStyles.EmphasisState paints on hover, so a focused button and a
; hovered one were the same picture. Content margins match EmphasisState's
; 16/10 so gaining focus never changes a button's size.
;
; draw_center = false makes this a ring drawn over whichever state box is
; already painted. button_focus.png is therefore the one slice authored with a
; *transparent* face - Godot still draws the corner and edge patches when the
; centre is skipped, so an opaque face there would black out the button's own
; frame everywhere but the middle.
[sub_resource type="StyleBoxTexture" id="sb_btn_focus"]
content_margin_left = 16.0
content_margin_top = 10.0
content_margin_right = 16.0
content_margin_bottom = 10.0
draw_center = false
texture = ExtResource("7")
texture_margin_left = 8.0
texture_margin_top = 8.0
texture_margin_right = 8.0
texture_margin_bottom = 8.0
axis_stretch_horizontal = 1
axis_stretch_vertical = 1

; --- Panels. The 16px slice rather than the buttons' 24: this is the theme
; default for every Panel, PanelContainer and TooltipPanel in the game, so it
; has to survive the shortest of them without folding its own corners together.
; Matches ChromeStyles.PanelStyle, which draws the same slice for the panels it
; builds in code.

[sub_resource type="StyleBoxTexture" id="sb_panel"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
texture = ExtResource("8")
texture_margin_left = 5.0
texture_margin_top = 5.0
texture_margin_right = 5.0
texture_margin_bottom = 5.0
axis_stretch_horizontal = 1
axis_stretch_vertical = 1

; --- ProgressBar: the unlocks screen was rendering a stock grey engine bar.
; Matches ChromeStyles.HpBarBackground/HpBarFill so the meta screen and the
; combat HP bars read as the same component.

[sub_resource type="StyleBoxFlat" id="sb_progress_bg"]
bg_color = Color(0.070588, 0.062745, 0.058824, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.419608, 0.290196, 0.121569, 1)

[sub_resource type="StyleBoxFlat" id="sb_progress_fill"]
bg_color = Color(0.611765, 0.435294, 0.180392, 1)

; --- Sliders (Settings volume) and scrollbars (Shop, Unlocks)

[sub_resource type="StyleBoxFlat" id="sb_slider"]
content_margin_top = 4.0
content_margin_bottom = 4.0
bg_color = Color(0.070588, 0.062745, 0.058824, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.419608, 0.290196, 0.121569, 1)

[sub_resource type="StyleBoxFlat" id="sb_slider_grabber"]
bg_color = Color(0.780392, 0.619608, 0.278431, 1)

[sub_resource type="StyleBoxFlat" id="sb_scroll"]
content_margin_left = 2.0
content_margin_right = 2.0
bg_color = Color(0.070588, 0.062745, 0.058824, 1)

[sub_resource type="StyleBoxFlat" id="sb_scroll_grabber"]
bg_color = Color(0.419608, 0.290196, 0.121569, 1)

[sub_resource type="StyleBoxFlat" id="sb_scroll_grabber_hl"]
bg_color = Color(0.780392, 0.619608, 0.278431, 1)

[resource]
default_font = ExtResource("2")
default_font_size = 16

Button/fonts/font = ExtResource("1")
Button/font_sizes/font_size = 16
Button/colors/font_color = Color(0.768627, 0.709804, 0.643137, 1)
Button/colors/font_hover_color = Color(0.929412, 0.894118, 0.831373, 1)
Button/colors/font_pressed_color = Color(0.921569, 0.780392, 0.4, 1)
Button/colors/font_disabled_color = Color(0.4, 0.34902, 0.313725, 1)
Button/colors/font_focus_color = Color(0.929412, 0.894118, 0.831373, 1)
Button/styles/normal = SubResource("sb_btn_normal")
Button/styles/hover = SubResource("sb_btn_hover")
Button/styles/pressed = SubResource("sb_btn_pressed")
Button/styles/disabled = SubResource("sb_btn_disabled")
Button/styles/focus = SubResource("sb_btn_focus")

Label/fonts/font = ExtResource("2")
Label/font_sizes/font_size = 16
Label/colors/font_color = Color(0.768627, 0.709804, 0.643137, 1)

RichTextLabel/fonts/normal_font = ExtResource("2")
RichTextLabel/font_sizes/normal_font_size = 16
RichTextLabel/colors/default_color = Color(0.768627, 0.709804, 0.643137, 1)

Panel/styles/panel = SubResource("sb_panel")
PanelContainer/styles/panel = SubResource("sb_panel")

TooltipLabel/fonts/font = ExtResource("2")
TooltipLabel/font_sizes/font_size = 24
TooltipLabel/colors/font_color = Color(0.929412, 0.894118, 0.831373, 1)
TooltipPanel/styles/panel = SubResource("sb_panel")

ProgressBar/styles/background = SubResource("sb_progress_bg")
ProgressBar/styles/fill = SubResource("sb_progress_fill")
ProgressBar/colors/font_color = Color(0.929412, 0.894118, 0.831373, 1)

HSlider/styles/slider = SubResource("sb_slider")
HSlider/styles/grabber_area = SubResource("sb_slider_grabber")
HSlider/styles/grabber_area_highlight = SubResource("sb_slider_grabber")

VScrollBar/styles/scroll = SubResource("sb_scroll")
VScrollBar/styles/grabber = SubResource("sb_scroll_grabber")
VScrollBar/styles/grabber_highlight = SubResource("sb_scroll_grabber_hl")
VScrollBar/styles/grabber_pressed = SubResource("sb_scroll_grabber_hl")
HScrollBar/styles/scroll = SubResource("sb_scroll")
HScrollBar/styles/grabber = SubResource("sb_scroll_grabber")
HScrollBar/styles/grabber_highlight = SubResource("sb_scroll_grabber_hl")
HScrollBar/styles/grabber_pressed = SubResource("sb_scroll_grabber_hl")

CheckButton/fonts/font = ExtResource("2")
CheckButton/font_sizes/font_size = 16
CheckButton/colors/font_color = Color(0.768627, 0.709804, 0.643137, 1)
CheckButton/colors/font_hover_color = Color(0.929412, 0.894118, 0.831373, 1)
; CheckButton had no styleboxes at all, so it fell back to the engine's stock
; theme - including its focus look, which is an off-palette grey box. The two
; Settings toggles are the only CheckButtons in the game and they have to show
; where the keyboard is like everything else.
CheckButton/colors/font_focus_color = Color(0.929412, 0.894118, 0.831373, 1)
CheckButton/styles/focus = SubResource("sb_btn_focus")

; Display variation for combat's large read-at-a-glance numbers (HP, damage,
; energy). Carried over from combat_theme.tres - it is used and it works. The
; hard outline matters more now than it did: pixel glyphs sit directly on
; sprite art, and with antialiasing off the outline is a clean 1-colour ring
; rather than a soft halo.
CombatDisplayLabel/base_type = &"Label"
CombatDisplayLabel/fonts/font = ExtResource("1")
CombatDisplayLabel/font_sizes/font_size = 24
CombatDisplayLabel/colors/font_color = Color(0.929412, 0.894118, 0.831373, 1)
CombatDisplayLabel/colors/font_outline_color = Color(0.027451, 0.023529, 0.039216, 1)
CombatDisplayLabel/constants/outline_size = 4

; Card and enemy names. Uses the *body* face, not the display face, which is
; a deliberate exception to the display/body split: Silkscreen is wide enough
; that the longest card name in the data ("Reckless Charge+", 16 chars) does
; not fit a 176px card at any legal size - 8px would fit but is unreadable.
; Tiny5 fits it at 16px (122px of the ~130px the banner leaves clear of the
; cost badge), and its lowercase reads better on a card face than all-caps.
; Silkscreen still owns HP/energy/damage numbers via CombatDisplayLabel,
; where its unambiguous digits are the whole point.
CardTitleLabel/base_type = &"Label"
CardTitleLabel/fonts/font = ExtResource("2")
CardTitleLabel/font_sizes/font_size = 16
CardTitleLabel/colors/font_color = Color(0.929412, 0.894118, 0.831373, 1)
CardTitleLabel/colors/font_outline_color = Color(0.027451, 0.023529, 0.039216, 1)
CardTitleLabel/constants/outline_size = 3
