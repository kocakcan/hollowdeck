[resource]
default_font = ExtResource("2")
default_font_size = 16

Button/fonts/font = ExtResource("1")
Button/font_sizes/font_size = 16
Button/colors/font_color = Color(0.768627, 0.709804, 0.643137, 1)
Button/colors/font_hover_color = Color(0.929412, 0.894118, 0.831373, 1)
Button/colors/font_pressed_color = Color(0.921569, 0.780392, 0.4, 1)
Button/colors/font_disabled_color = Color(0.4, 0.34902, 0.313725, 1)
Button/colors/font_focus_color = Color(0.929412, 0.894118, 0.831373, 1)
Button/styles/normal = SubResource("sb_btn_normal")
Button/styles/hover = SubResource("sb_btn_hover")
Button/styles/pressed = SubResource("sb_btn_pressed")
Button/styles/disabled = SubResource("sb_btn_disabled")
Button/styles/focus = SubResource("sb_btn_focus")

Label/fonts/font = ExtResource("2")
Label/font_sizes/font_size = 16
Label/colors/font_color = Color(0.768627, 0.709804, 0.643137, 1)

RichTextLabel/fonts/normal_font = ExtResource("2")
RichTextLabel/font_sizes/normal_font_size = 16
RichTextLabel/colors/default_color = Color(0.768627, 0.709804, 0.643137, 1)

Panel/styles/panel = SubResource("sb_panel")
PanelContainer/styles/panel = SubResource("sb_panel")

ProgressBar/styles/background = SubResource("sb_progress_bg")
ProgressBar/styles/fill = SubResource("sb_progress_fill")
ProgressBar/colors/font_color = Color(0.929412, 0.894118, 0.831373, 1)

HSlider/styles/slider = SubResource("sb_slider")
HSlider/styles/grabber_area = SubResource("sb_slider_grabber")
HSlider/styles/grabber_area_highlight = SubResource("sb_slider_grabber")

VScrollBar/styles/scroll = SubResource("sb_scroll")
VScrollBar/styles/grabber = SubResource("sb_scroll_grabber")
VScrollBar/styles/grabber_highlight = SubResource("sb_scroll_grabber_hl")
VScrollBar/styles/grabber_pressed = SubResource("sb_scroll_grabber_hl")
HScrollBar/styles/scroll = SubResource("sb_scroll")
HScrollBar/styles/grabber = SubResource("sb_scroll_grabber")
HScrollBar/styles/grabber_highlight = SubResource("sb_scroll_grabber_hl")
HScrollBar/styles/grabber_pressed = SubResource("sb_scroll_grabber_hl")

CheckButton/fonts/font = ExtResource("2")
CheckButton/font_sizes/font_size = 16
CheckButton/colors/font_color = Color(0.768627, 0.709804, 0.643137, 1)
CheckButton/colors/font_hover_color = Color(0.929412, 0.894118, 0.831373, 1)

; Display variation for combat's large read-at-a-glance numbers (HP, damage,
; energy). Carried over from combat_theme.tres - it is used and it works. The
; hard outline matters more now than it did: pixel glyphs sit directly on
; sprite art, and with antialiasing off the outline is a clean 1-colour ring
; rather than a soft halo.
CombatDisplayLabel/base_type = &"Label"
CombatDisplayLabel/fonts/font = ExtResource("1")
CombatDisplayLabel/font_sizes/font_size = 24
CombatDisplayLabel/colors/font_color = Color(0.929412, 0.894118, 0.831373, 1)
CombatDisplayLabel/colors/font_outline_color = Color(0.027451, 0.023529, 0.039216, 1)
CombatDisplayLabel/constants/outline_size = 4

; Card and enemy names. Uses the *body* face, not the display face, which is
; a deliberate exception to the display/body split: Silkscreen is wide enough
; that the longest card name in the data ("Reckless Charge+", 16 chars) does
; not fit a 176px card at any legal size - 8px would fit but is unreadable.
; Tiny5 fits it at 16px (122px of the ~130px the banner leaves clear of the
; cost badge), and its lowercase reads better on a card face than all-caps.
; Silkscreen still owns HP/energy/damage numbers via CombatDisplayLabel,
; where its unambiguous digits are the whole point.
CardTitleLabel/base_type = &"Label"
CardTitleLabel/fonts/font = ExtResource("2")
CardTitleLabel/font_sizes/font_size = 16
CardTitleLabel/colors/font_color = Color(0.929412, 0.894118, 0.831373, 1)
CardTitleLabel/colors/font_outline_color = Color(0.027451, 0.023529, 0.039216, 1)
CardTitleLabel/constants/outline_size = 3
