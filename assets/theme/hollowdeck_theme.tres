; The one project-wide theme, set as gui/theme/custom in project.godot.
;
; Merged from the two themes that used to fight: this file's own slate-blue
; generic dark-UI styleboxes (bg 0.165,0.184,0.243, no font at all) and
; combat_theme.tres's typography, which was attached to only 3 of 13 scenes.
; That split is why Shop/Rest/Event/Treasure/RunEnd/Settings/Unlocks/Map
; rendered in stock Godot sans-serif with grey-blue buttons while combat sat
; in bronze bezels. There are no per-scene theme overrides any more.
;
; Every colour below is a PixelSpec.Ramp entry (docs/ART_SPEC.md section 5).
; Per section 6 there are no corner radii and no shadow blurs anywhere -
; both are anti-aliased effects that cannot exist in pixels.

[gd_resource type="Theme" load_steps=14 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Silkscreen-Bold.ttf" id="1"]
[ext_resource type="FontFile" path="res://assets/fonts/Tiny5-Regular.ttf" id="2"]

; --- Buttons: N2 face, G1 bezel; hover brightens the bezel to G3 rather than
; swapping hue, the same "hover is a pure brightness signal" rule CardView's
; frame styling already follows.

[sub_resource type="StyleBoxFlat" id="sb_btn_normal"]
