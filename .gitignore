# Godot 4+ specific ignores
.godot/
/android/

# Mono/.NET-specific ignores
.mono/
data_*/

# Packaged exports (tools/build-export.sh). Each build is a *directory*, not a
# file: dotnet/embed_build_outputs is off, so the .NET assemblies land in a
# sibling data_Hollowdeck_<platform>_<arch>/ folder beside the executable rather
# than inside the .pck - which is what the data_*/ rule above has been covering
# since the Mono era. Neither line is redundant; delete either and something
# ships that shouldn't be tracked.
/build/

# C#/.NET build artifacts (the .sln/.csproj themselves ARE committed)
.vs/
.idea/
bin/
obj/
*.csproj.user

# tools/artgen is a Rust build; its output is the PNGs under assets/, which
# ARE committed. Cargo.lock is committed too - artgen is a binary, and a
# pinned lockfile is what makes "re-run it and get the same assets" true.
tools/artgen/target/

# OS cruft
.DS_Store

# Claude Code local state (personal permissions, scratch worktrees) - but the
# skills ARE committed: they document this repo's own tooling (the screenshot
# harness and the smoke-test catalog) and have to stay versioned alongside the
# code they describe. Note the `.claude/*` glob: git can't re-include a path
# inside a directory that was itself excluded, so a bare `.claude/` would make
# the negation below unreachable.
.claude/*
!.claude/skills/
__pycache__/
